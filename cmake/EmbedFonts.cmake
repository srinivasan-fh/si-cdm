# Embeds binary resources (UI fonts, app icons) into generated C++ sources, so
# the app needs no resource files at run time. Re-runs when a file changes.

# Writes `out` defining `const Blob <id>` in namespace `ns` for each file
# (id = file name without extension as a C identifier), declared in `header`.
function(sicdm_embed_blobs out header ns)
    set(code "// Generated by cmake/EmbedFonts.cmake. Do not edit.\n")
    string(APPEND code "#include \"${header}\"\n\nnamespace ${ns} {\n\n")
    foreach(file IN LISTS ARGN)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hexLength)
        math(EXPR size "${hexLength} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        get_filename_component(name "${file}" NAME_WE)
        string(MAKE_C_IDENTIFIER "${name}" id)
        string(APPEND code "static const unsigned char k_${id}[${size}] = {\n${bytes}};\n")
        string(APPEND code "const Blob ${id}{k_${id}, ${size}};\n\n")
    endforeach()
    string(APPEND code "} // namespace ${ns}\n")
    # Only rewrite when the content changes, so builds stay incremental.
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL code)
        file(WRITE "${out}" "${code}")
    endif()
endfunction()

# The fonts (resources/fonts), compiled into the core library; `out_var` receives the
# generated source.
function(sicdm_embed_core_fonts out_var)
    set(fonts "${CMAKE_CURRENT_SOURCE_DIR}/resources/fonts")
    set(gen "${CMAKE_CURRENT_BINARY_DIR}/generated")
    sicdm_embed_blobs("${gen}/EmbeddedFonts.cpp" "core/FontData.hpp" "sicdm::fonts"
        "${fonts}/Inter-Regular.ttf" "${fonts}/Inter-SemiBold.ttf" "${fonts}/JetBrainsMono-Regular.ttf")
    set(${out_var} "${gen}/EmbeddedFonts.cpp" PARENT_SCOPE)
endfunction()

# Window icons (resources/icon) for the app; `out_var` receives the generated source.
function(sicdm_embed_fonts out_var)
    set(icons "${CMAKE_CURRENT_SOURCE_DIR}/resources/icon")
    set(gen "${CMAKE_CURRENT_BINARY_DIR}/generated")
    sicdm_embed_blobs("${gen}/EmbeddedIcons.cpp" "ui/EmbeddedFonts.hpp" "sicdm::icons"
        "${icons}/sicdm_256.png" "${icons}/sicdm_64.png" "${icons}/sicdm_32.png")
    set(${out_var} "${gen}/EmbeddedIcons.cpp" PARENT_SCOPE)
endfunction()
