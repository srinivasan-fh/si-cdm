# Embeds the UI fonts (resources/fonts/*.ttf) into a generated C++ source, so the
# app needs no font files at run time. Re-runs when a font file changes.
function(sicdm_embed_fonts out_var)
    set(fonts Inter-Regular Inter-SemiBold JetBrainsMono-Regular)
    set(dir "${CMAKE_CURRENT_SOURCE_DIR}/resources/fonts")
    set(out "${CMAKE_CURRENT_BINARY_DIR}/generated/EmbeddedFonts.cpp")
    set(code "// Generated by cmake/EmbedFonts.cmake from resources/fonts. Do not edit.\n")
    string(APPEND code "#include \"ui/EmbeddedFonts.hpp\"\n\nnamespace sicdm::fonts {\n\n")
    foreach(font IN LISTS fonts)
        set(file "${dir}/${font}.ttf")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hexLength)
        math(EXPR size "${hexLength} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        string(MAKE_C_IDENTIFIER "${font}" id)
        string(APPEND code "static const unsigned char k_${id}[${size}] = {\n${bytes}};\n")
        string(APPEND code "const Blob ${id}{k_${id}, ${size}};\n\n")
    endforeach()
    string(APPEND code "} // namespace sicdm::fonts\n")
    # Only rewrite when the content changes, so builds stay incremental.
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL code)
        file(WRITE "${out}" "${code}")
    endif()
    set(${out_var} "${out}" PARENT_SCOPE)
endfunction()
