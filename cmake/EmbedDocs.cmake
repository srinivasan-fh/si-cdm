# Writes OUTPUT: a C++ source with the user guide (docs/*.md) and the example scripts
# (docs/examples/*.txt) as text, for the in-app help. Run as a script:
#   cmake -DDOCS_DIR=... -DOUTPUT=... -P EmbedDocs.cmake
# Each file is split into pieces under 8000 bytes (compilers limit one literal's length).

file(GLOB guides "${DOCS_DIR}/*.md")
file(GLOB examples "${DOCS_DIR}/examples/*.txt")
list(SORT guides)
list(SORT examples)

set(out "// Generated by cmake/EmbedDocs.cmake from docs/: do not edit.\n#include \"core/HelpDocs.hpp\"\n\nnamespace sicdm {\n\n")
string(APPEND out "const std::vector<EmbeddedFile>& embeddedDocFiles() {\n    static const std::vector<EmbeddedFile> files = {\n")
foreach(path IN LISTS guides examples)
    file(RELATIVE_PATH rel "${DOCS_DIR}" "${path}")
    file(READ "${path}" text)
    string(LENGTH "${text}" n)
    string(APPEND out "        {\"${rel}\", {")
    set(pos 0)
    while(pos LESS n)
        math(EXPR left "${n} - ${pos}")
        if(left GREATER 8000)
            set(left 8000)
        endif()
        string(SUBSTRING "${text}" ${pos} ${left} piece)
        string(APPEND out "R\"sicdmdoc(${piece})sicdmdoc\", ")
        math(EXPR pos "${pos} + ${left}")
    endwhile()
    string(APPEND out "}},\n")
endforeach()
string(APPEND out "    };\n    return files;\n}\n\n} // namespace sicdm\n")
file(WRITE "${OUTPUT}.tmp" "${out}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
